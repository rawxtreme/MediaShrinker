<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050816">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF"
            android:padding="6dp"
            android:background="@drawable/card_bg" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="16dp"
            android:text="Terms of Use"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1AFFFFFF"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last updated: 12 September 2026 — v11.0"
                android:textColor="#88FFFFFF"
                android:textSize="12sp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Acceptance of Terms"
                android:textColor="#3B82F6"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="By downloading, installing, or using MediaShrinker (v11.0 and any future version), you agree to these Terms of Use. If you do not agree, please do not use the app."
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Your Responsibility"
                android:textColor="#3B82F6"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MediaShrinker is provided as a free tool to help you compress, convert, clean up and manage photos and PDFs on your own device. Like any other software or app, you — the user — are solely responsible for how you use it.\n\nThis includes, but is not limited to:\n\n• Choosing which photos to compress, convert, resize, or permanently delete.\n• Verifying important photos are backed up elsewhere before using irreversible actions like Magic Cleaner's delete function or Metadata Remover.\n• Ensuring you have the right to edit, compress, or strip metadata from any photo you process, especially images that aren't your own.\n• Any consequences that result from deleting, overwriting, or losing files while using this app.\n\nMediaShrinker performs the actions you explicitly request (for example, confirming a delete or a compression). Once an action is confirmed, it generally cannot be undone."
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. No Warranty"
                android:textColor="#3B82F6"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MediaShrinker is provided &quot;as is&quot; and &quot;as available&quot;, without warranties of any kind, express or implied. The developer does not guarantee the app will be error-free, uninterrupted, or fit for any particular purpose."
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Limitation of Liability"
                android:textColor="#3B82F6"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To the fullest extent permitted by law, the developer of MediaShrinker shall not be held liable for any loss of data, photos, files, or any direct or indirect damages arising from the use or inability to use this app. You use all features — especially permanent-delete features — at your own risk and discretion."
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. Appropriate Use"
                android:textColor="#3B82F6"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You agree to use MediaShrinker only for lawful purposes and in a way that does not infringe the rights of, or restrict or inhibit the use and enjoyment of, this app by any third party."
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6. Changes to These Terms"
                android:textColor="#3B82F6"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="These Terms may be updated as the app evolves. Continued use of MediaShrinker after an update means you accept the revised Terms. Check Patch Notes in Settings for what changed in each version."
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7. App Distribution &amp; Modification Policy"
                android:textColor="#3B82F6"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modifying or making changes to this app&apos;s code is strictly prohibited. Distribution is only allowed when other users are installing from GitHub or any specific sources where this app is uploaded by the original owner/developer of this app where this app is available to download. If any changes or editing in the app&apos;s code and then distributing is caught, a lawsuit will be initiated on the culprit."
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8. Contact"
                android:textColor="#3B82F6"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Questions about these Terms can be sent to:\n\n• Instagram: &#64;carryon.aditya\n• scope8xaditya&#64;gmail.com\n• GitHub: github.com/rawxtreme"
                android:textColor="#CCFFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="40dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
